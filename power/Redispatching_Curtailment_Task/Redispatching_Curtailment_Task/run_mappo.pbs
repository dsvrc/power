#!/bin/bash
#PBS -N mappo_g2op
#PBS -P few_res.spons
#PBS -l select=1:ncpus=32:mem=96gb
#PBS -l walltime=24:00:00
#PBS -J 0-2
#PBS -m bea
#PBS -o logs/
#PBS -e logs/

# Submit as an array (one job per seed):   qsub run_mappo.pbs
# Or as a single seed, if -J is disabled:  qsub -v SEED=0 run_mappo.pbs

set -euo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p logs

# Seed comes from the array index, or from -v SEED=<n>, defaulting to 0.
SEED="${PBS_ARRAY_INDEX:-${SEED:-0}}"

source /scratch/dbst/phd/bsz178495/anaconda3/etc/profile.d/conda.sh
conda activate marl2grid_py312

# Cores granted by PBS for this chunk. --n_envs auto reads the cpuset directly,
# this is only used to keep BLAS from oversubscribing.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export GRID2OP_DATA_PATH=/scratch/dbst/phd/bsz178495/data_grid2op

python main.py \
    --n_frames 1_000_000 \
    --alg MAPPO \
    --lr 3e-5 \
    --MAPPO_n_episode 30 \
    --seeds "$SEED" \
    --n_envs auto
